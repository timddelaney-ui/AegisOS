MONGO_URL=mongodb://localhost:27017
DB_NAME=aegisos
# Set to "production" to enforce required secrets and explicit CORS origins
APP_ENV=development
# Comma-separated explicit origins (required when APP_ENV=production)
CORS_ORIGINS=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMERGENT_LLM_KEY=
# Set to r2 only after the private R2 bucket and all credentials are configured.
ATTACHMENT_STORAGE_BACKEND=emergent
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
DATA_REGION=us-east
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SMS_PROVIDER=none
SMS_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Comma-separated owner emails: all plans, roles and trial limits are unlocked for these accounts
ADMIN_EMAILS=
BETA_UNLOCK=false
CT_FREE_FOR_ALL=false
HITL_ENFORCE_OUTBOUND=true

# Cloud MQTT consumer (see docs/EDGE_GATEWAY.md). EMQX Cloud uses MQTT/TLS on port 8883.
# Broker topic scope must use the exact Aegis team_id and rig_id:
# aegis/<team_id>/<rig_id>/telemetry/{snapshots|events|consensus}
# Configure credentials as backend deployment secrets; never in the browser.
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtts://your-deployment.emqxsl.com:8883
MQTT_TLS_CA=
MQTT_CLIENT_CERT=
MQTT_CLIENT_KEY=
# Managed brokers (EMQX Cloud / HiveMQ): username+password auth, public CA (MQTT_TLS_CA optional)
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=aegis-cloud-consumer

# Self-hosted auth/AI (no Emergent dependency). Google OAuth redirect URI to register:
#   ${PUBLIC_API_URL}/api/auth/google/callback
PUBLIC_APP_URL=https://mycoiltubingpocketsupports.tech
PUBLIC_API_URL=https://api.mycoiltubingpocketsupports.tech
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
# CORS_ORIGINS=https://mycoiltubingpocketsupports.tech   (frontend REACT_APP_BACKEND_URL = PUBLIC_API_URL)
