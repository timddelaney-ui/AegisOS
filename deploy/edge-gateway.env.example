AEGIS_SQLITE_PATH=/var/lib/aegis-edge/telemetry.sqlite3
# 0 means no application-level cap; monitor disk and provision adequate storage.
AEGIS_MAX_PENDING=0

AEGIS_DEVICE_ID=replace-with-unique-rig-id
AEGIS_MQTT_HOST=replace-with-tls-mqtt-broker
AEGIS_MQTT_PORT=8883
AEGIS_MQTT_USERNAME=replace-with-device-scoped-username
AEGIS_MQTT_PASSWORD=replace-with-secret
AEGIS_MQTT_CA_FILE=/etc/ssl/certs/ca-certificates.crt
AEGIS_MQTT_QOS=2
AEGIS_MQTT_TOPIC_PREFIX=aegis
AEGIS_PUBLISHED_RETENTION_DAYS=30
# Optional mutual TLS; set both or neither.
# AEGIS_MQTT_CLIENT_CERT=/etc/aegis-edge/client.crt
# AEGIS_MQTT_CLIENT_KEY=/etc/aegis-edge/client.key

# Supported values: wits0, wits0_tcp, modbus, modbus_tcp.
AEGIS_DAQ_PROTOCOL=wits0
AEGIS_DAQ_CONFIG={"host":"127.0.0.1","port":12345}
